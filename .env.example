# Language model (required for the assistant to answer)
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Web search and page scraping (optional; without it the assistant answers
# from statistics and embeddings alone)
# https://anakin.io
ANAKIN_API_KEY=

# Kaggle, used only by scripts/download_data.py
KAGGLE_USERNAME=
KAGGLE_KEY=

# Agent behaviour. The free Groq tier meters 8,000 tokens a minute and the
# whole conversation is resent on every turn, so more iterations means more
# 429s, not better answers.
MAX_AGENT_ITERATIONS=5
AGENT_TEMPERATURE=0.2
MAX_COMPLETION_TOKENS=1600

# Fail a stalled provider call rather than leaving the page on "Thinking".
GROQ_TIMEOUT=45
GROQ_MAX_RETRIES=1

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
